# =============================================================================
# EduGuard Server Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=8080

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# MongoDB connection string
# Local: mongodb://localhost:27017/eduguard
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/eduguard
MONGODB_URI=mongodb://localhost:27017/eduguard

# -----------------------------------------------------------------------------
# Security & Authentication
# -----------------------------------------------------------------------------
# IMPORTANT: Generate a strong random secret for production
# Example: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_IN_PRODUCTION

# JWT token expiration (e.g., 7d, 24h, 60m)
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# CORS & Client
# -----------------------------------------------------------------------------
# Frontend URL (used for CORS)
CLIENT_ORIGIN=http://localhost:5174

# -----------------------------------------------------------------------------
# Email Configuration (for password reset)
# -----------------------------------------------------------------------------
# SMTP server settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Email credentials
# For Gmail: Use App Password (https://support.google.com/accounts/answer/185833)
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password

# Email sender display name
MAIL_FROM=EduGuard Security <your-email@gmail.com>

# -----------------------------------------------------------------------------
# Admin Configuration
# -----------------------------------------------------------------------------
# REQUIRED: Email address of the super admin account
# Only this email can access admin login and admin APIs
SUPER_ADMIN_EMAIL=admin@yourdomain.com

# OPTIONAL: Recovery email for admin password reset OTP
# If set, admin password reset OTPs will be sent here instead of SUPER_ADMIN_EMAIL
# Useful when you cannot access the admin email inbox
# ADMIN_RECOVERY_EMAIL=developer@yourdomain.com

# -----------------------------------------------------------------------------
# Logging (Optional)
# -----------------------------------------------------------------------------
# Log level: ERROR, WARN, INFO, DEBUG
# LOG_LEVEL=INFO
